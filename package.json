{
  "name": "ai-interview-preparation-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI Interview Preparation Platform - Full-stack monorepo",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace=server run dev\" \"npm --workspace=client run dev\"",
    "dev:client": "npm --workspace=client run dev",
    "dev:server": "npm --workspace=server run dev",
    "build:client": "npm --workspace=client run build",
    "preview:client": "npm --workspace=client run preview",
    "start:server": "npm --workspace=server run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
