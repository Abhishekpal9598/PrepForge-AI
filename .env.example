# ==========================================
# AI Interview Preparation Platform
# Environment Configuration Template
# ==========================================

# Server Network Configuration
PORT=5002
NODE_ENV=development

# Frontend Client URL (for CORS allowlisting)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai_interview_prep
TEST_MONGODB_URI=mongodb://localhost:27017/ai_interview_prep_test

# Authentication Secrets (Deferred to Phase 3)
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_placeholder

# Google Gemini AI Configuration (Deferred to Phase 5)
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=
